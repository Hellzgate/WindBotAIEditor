<Window x:Class="WindBotAIEditor.PreReleasePreviewWindow"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextFg}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프리릴리즈 → 정규 카드 ID 변환 (미리보기)" Height="600" Width="940"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Malgun Gothic" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="WarnFg2" Color="#E08B2A"/>
    </Window.Resources>
    <DockPanel Margin="12">

        <!-- 안내 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="변경 목록 (적용 전 확인)" FontWeight="Bold"/>
            <TextBlock x:Name="TxtInfo" Foreground="{DynamicResource SubtleFg}" FontSize="12" Margin="0,2,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                BorderBrush="{DynamicResource BorderBrush2}">
            <TextBlock x:Name="TxtWarn" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource WarnFg2}"/>
        </Border>

        <!-- 하단 버튼 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="TxtSummary" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold"/>
            <Button Content="적용" Padding="20,5" IsDefault="True" Click="OnApply"/>
            <Button Content="취소" Padding="20,5" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>

        <DataGrid x:Name="GridChanges" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="대상" Binding="{Binding Target}" Width="70"/>
                <DataGridTextColumn Header="프리릴리즈 ID" Binding="{Binding From}" Width="120"/>
                <DataGridTextColumn Header="정규 ID" Binding="{Binding To}" Width="110"/>
                <DataGridTextColumn Header="카드명" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="위치" Binding="{Binding Where}" Width="280"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
