<UserControl x:Class="WindBotAIEditor.CardDbPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Malgun Gothic" FontSize="13">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 카드 검색 -->
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtSearch" Padding="4" KeyDown="OnSearchKey"/>
                <Button Grid.Column="1" Content="검색" Margin="6,0,0,0" Click="OnSearch"/>
                <TextBlock Grid.Column="2" x:Name="LblCount" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource SubtleFg}"/>
            </Grid>
            <DataGrid x:Name="GridResults" IsReadOnly="True" SelectionChanged="OnSelected">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90"/>
                    <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="공격" Binding="{Binding Atk}" Width="60"/>
                    <DataGridTextColumn Header="수비" Binding="{Binding Def}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- 상세 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="110"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="카드 ID" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtCardId" Width="110" Padding="3"/>
                <Button Content="ID 복사" Margin="6,0,0,0" Click="OnCopyId"/>
                <Button Content="이 ID로 규칙 카드 채우기" Margin="10,0,0,0" Click="OnApplyToRule"/>
            </StackPanel>

            <TextBox Grid.Row="1" x:Name="TxtInfo" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2" x:Name="LblScript" Foreground="{DynamicResource SubtleFg}" Margin="0,0,0,4" TextWrapping="Wrap"/>

            <DockPanel Grid.Row="3" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Top" Text="이 카드의 효과 번호 (Lua SetDescription)" FontWeight="Bold" Margin="0,0,0,3"/>
                <ListBox x:Name="ListEffects" FontSize="12"/>
            </DockPanel>

            <Grid Grid.Row="4" Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="시스템 효과 설명 (strings.conf)" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="TxtEffectFilter" Padding="3" TextChanged="OnEffectFilterChanged"/>
            </Grid>

            <ListBox Grid.Row="5" x:Name="ListSystem" FontSize="12" MouseDoubleClick="OnSystemEffectClick" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="6" Text="Lua 스크립트" FontWeight="Bold" Margin="0,0,0,3"/>

            <TextBox Grid.Row="7" x:Name="TxtLua" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Grid>
    </Grid>
</UserControl>

