<Window x:Class="WindBotAIEditor.ImportModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="다른 JSON 불러오기" Height="230" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#2B2D30" Foreground="#EAEAEA" FontSize="13">
    <StackPanel Margin="18">
        <TextBlock x:Name="TxtInfo" TextWrapping="Wrap" Foreground="#EAEAEA"/>
        <TextBlock Text="어떻게 불러올까요?" Margin="0,14,0,0" FontWeight="SemiBold" Foreground="#EAEAEA"/>
        <TextBlock Text="· 덮어쓰기 = 지금 규칙을 모두 지우고 이 파일로 교체 (전역 설정도 파일 값으로)"
                   FontSize="11" Foreground="#A0A4AA" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock Text="· 추가(병합) = 지금 규칙 뒤에 이어 붙임 · 중복은 건너뜀 · 전역 설정은 유지"
                   FontSize="11" Foreground="#A0A4AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BtnReplace" Content="덮어쓰기" Width="96" Height="30" Click="OnReplace"
                    ToolTip="현재 규칙을 모두 지우고 이 파일의 규칙·전역 설정으로 교체합니다"/>
            <Button x:Name="BtnMerge" Content="추가(병합)" Width="110" Height="30" Margin="8,0,0,0" Click="OnMerge"
                    ToolTip="현재 규칙 뒤에 이어 붙입니다(중복 건너뜀, 전역 설정 유지)"/>
            <Button x:Name="BtnCancel" Content="취소" Width="76" Height="30" Margin="8,0,0,0" Click="OnCancel"
                    IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
