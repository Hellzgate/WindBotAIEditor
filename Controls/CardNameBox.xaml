<UserControl x:Class="WindBotAIEditor.Controls.CardNameBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13" MinWidth="86">
    <!-- 2026-11-07: 표 안에서 "입력칸"임이 보이도록 테두리/배경을 Border 로 직접 그린다.
         (TextBox 의 ThemedTextBox 템플릿은 표 배경과 대비가 약해 글자처럼 보였다) -->
    <Grid>
        <Border x:Name="Box" Background="{DynamicResource InputBg}" CornerRadius="3"
                BorderThickness="1" Margin="1" SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Txt}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusRing}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <TextBox x:Name="Txt" Padding="6,3" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource TextFg}"
                         VerticalContentAlignment="Center"
                         TextChanged="OnTextChanged"
                         PreviewKeyDown="OnPreviewKeyDown"
                         LostFocus="OnLostFocus" GotFocus="OnGotFocus"/>
                <!-- 입력 힌트: 이름으로 검색된다는 것을 아이콘 없이 글자로 -->
                <TextBlock x:Name="TxtHint" Text="이름 검색" IsHitTestVisible="False"
                           Foreground="{DynamicResource HintFg}" FontSize="11"
                           Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Margin="0,2,0,0"
                    Width="{Binding ActualWidth, ElementName=Txt}" MaxHeight="240">
                <ListBox x:Name="Lst" BorderThickness="0" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextFg}"
                         MouseLeftButtonUp="OnItemClick" PreviewKeyDown="OnListKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Width="190" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFg}"/>
                                <TextBlock Text="{Binding Id}" Foreground="{DynamicResource SubtleFg}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
