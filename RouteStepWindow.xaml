<Window x:Class="WindBotAIEditor.RouteStepWindow"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextFg}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindBotAIEditor"
        xmlns:controls="clr-namespace:WindBotAIEditor.Controls"
        Title="⑤ 단계 조건 편집" Height="660" Width="1180"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Malgun Gothic" FontSize="13">

    <Window.Resources>
        <local:ConditionGroupBrushConverter x:Key="GroupBrush"/>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- 상단: 안내 + 편집 대상(루트 진입 조건 / 순위 조건) -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock x:Name="TxtInfo" Foreground="{DynamicResource SubtleFg}" FontSize="12" TextWrapping="Wrap"/>
            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="편집 대상:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0"/>
                <ComboBox x:Name="CmbCondTarget" Width="420" MinHeight="28" HorizontalAlignment="Left"
                          Style="{DynamicResource ThemedComboBox}"
                          SelectionChanged="OnCondTargetChanged"
                          ToolTip="루트 진입 조건 또는 그 단계의 순위 조건을 골라 편집합니다"/>
                <TextBlock x:Name="TxtStepNote" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource SubtleFg}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="조건 추가" MinHeight="28" MinWidth="80" Click="OnAddCond"/>
                <Button Content="행 삭제" MinHeight="28" MinWidth="70" Margin="4,0,0,0" Click="OnRemoveCond"/>
                <TextBlock Text="연결(and/or)·그룹은 조건 그리드와 동일하게 동작합니다. 편집 즉시 규칙에 반영됩니다."
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource HintFg}" FontSize="11"/>
            </StackPanel>
        </StackPanel>

        <!-- 하단: 생성식 미리보기 + 버튼 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush2}"
                    Background="{DynamicResource InputBg}" Padding="8,6">
                <StackPanel>
                    <TextBlock Text="생성식 미리보기" FontSize="11" Foreground="{DynamicResource SubtleFg}"/>
                    <TextBlock x:Name="TxtExpr" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               Margin="0,2,0,0" Foreground="{DynamicResource TextFg}"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="복사" MinHeight="28" MinWidth="70" Click="OnCopy" ToolTip="이 단계의 요약을 클립보드로 복사"/>
                <Button Content="닫기" MinHeight="28" MinWidth="90" Margin="6,0,0,0" Click="OnClose"
                        ToolTip="닫기 (Esc) — 편집 내용은 이미 규칙에 반영되어 있습니다"/>
            </StackPanel>
        </StackPanel>

        <!-- 본문: 조건 편집 그리드 -->
        <DataGrid x:Name="GridConds" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="30"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextFg}"
                  BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                  AlternatingRowBackground="{DynamicResource CardBg}"
                  SelectionChanged="OnGridSelectionChanged"
                  CurrentCellChanged="OnGridSelectionChanged"
                  ToolTip="조건 편집 — 셀을 클릭해 값을 바꿉니다 (본 화면 조건 그리드와 같은 항목)">
            <DataGrid.Columns>

                <!-- 연결 (첫 행은 — 로 표시) -->
                <DataGridTemplateColumn Width="56">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="연결" ToolTip="앞 조건과의 연결(and/or). 첫 행은 사용되지 않습니다"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <ComboBox ItemsSource="{Binding Source={x:Static local:MainWindow.Joins}}"
                                          SelectedItem="{Binding Join, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="앞 조건과 AND / OR 로 잇습니다">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource ThemedComboBox}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding JoinEnabled}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                                <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubtleFg}" ToolTip="첫 조건 — 연결값은 사용되지 않습니다">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding JoinEnabled}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 그룹(괄호) -->
                <DataGridTemplateColumn Width="54">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="그룹" ToolTip="같은 번호끼리 먼저 묶입니다(괄호). 예: A(0)·B(1)·C(1,or) → A &amp;&amp; (B || C)"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="1" Background="{Binding Group, Converter={StaticResource GroupBrush}}"
                                    ToolTip="{Binding GroupBadge}">
                                <ComboBox Style="{DynamicResource ThemedComboBox}" Height="22" BorderThickness="0"
                                          Background="Transparent" Foreground="White" FontWeight="Bold"
                                          ItemsSource="{Binding Source={x:Static local:MainWindow.CondGroupNumbers}}"
                                          SelectedItem="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 조건 종류 -->
                <DataGridTemplateColumn Header="조건" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{DynamicResource ThemedComboBox}"
                                      ItemsSource="{Binding Source={x:Static local:MainWindow.ConditionKinds}}"
                                      SelectedItem="{Binding KindName, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Label"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="비교" Width="54">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{DynamicResource ThemedComboBox}"
                                      ItemsSource="{Binding Source={x:Static local:MainWindow.Ops}}"
                                      SelectedItem="{Binding Op, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="값" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                <DataGridTextColumn Binding="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="52">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="장수" ToolTip="[필드에 레벨 N 몬스터 M장] 조건의 M. 다른 조건에서는 무시. 0 = 1장"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="카드ID" Binding="{Binding Card, UpdateSourceTrigger=PropertyChanged}" Width="74"/>
                <DataGridTemplateColumn Header="카드명 (이름으로 검색)" Width="*" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:CardNameBox CardId="{Binding Card, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  AllowEmpty="True" EmptyLabel="(없음)"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="대상(누가)" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{DynamicResource ThemedComboBox}"
                                      ItemsSource="{Binding Source={x:Static local:MainWindow.Sides}}"
                                      SelectedValuePath="Id" DisplayMemberPath="Label"
                                      IsEnabled="{Binding SideEditable}"
                                      SelectedValue="{Binding Side, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="종족" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:OptionSearchBox Options="{Binding Source={x:Static local:MainWindow.Races}}"
                                                      SelectedCode="{Binding RaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      AllowZero="True" ZeroLabel="전체 (종족 무관)"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="테마" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:OptionSearchBox Options="{Binding Source={x:Static local:MainWindow.Themes}}"
                                                      SelectedCode="{Binding ThemeCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding ThemeEditable}"
                                                      AllowZero="True" ZeroLabel="전체 (테마 무관)"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="몬스터만" Width="68">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding MonsterOnly, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsEnabled="{Binding ThemeEditable}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="부정(!)" Width="62">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Not, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ToolTip="조건을 뒤집습니다 (!(...))"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
