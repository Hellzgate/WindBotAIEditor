<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBg" Color="#252526"/>
    <SolidColorBrush x:Key="CardBg" Color="#2B2D30"/>
    <SolidColorBrush x:Key="SubtleBg" Color="#232323"/>
    <SolidColorBrush x:Key="InputBg" Color="#333337"/>
    <SolidColorBrush x:Key="TextFg" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="SubtleFg" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="HintFg" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="#3F3F46"/>
    <SolidColorBrush x:Key="GridHeaderBg" Color="#33363B"/>
    <SolidColorBrush x:Key="GridAltBg" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="GridLine" Color="#3A3A3A"/>
