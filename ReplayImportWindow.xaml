<Window x:Class="WindBotAIEditor.ReplayImportWindow"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextFg}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="리플레이에서 전개 루트 가져오기" Height="660" Width="900"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Malgun Gothic" FontSize="13">
    <Window.Resources>
        <!-- ⑤ 탭의 강조색과 같은 계열 (이 창은 메인 창 리소스를 물려받지 않는다) -->
        <SolidColorBrush x:Key="WarnFg" Color="#E08B2A"/>
    </Window.Resources>
    <DockPanel Margin="12">

        <!-- 파일 정보 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="TxtFile" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TxtReplayInfo" Foreground="{DynamicResource SubtleFg}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 내 쪽 선택 -->
        <Border DockPanel.Dock="Top" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8"
                BorderBrush="{DynamicResource BorderBrush2}" Background="{DynamicResource PanelBg}">
            <StackPanel>
                <TextBlock Text="내 쪽 (이 플레이어의 행동만 기록합니다)" FontWeight="Bold" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbSide0" GroupName="MySide" Margin="0,0,24,0"
                                 Checked="OnSideChanged" VerticalContentAlignment="Center"/>
                    <RadioButton x:Name="RbSide1" GroupName="MySide"
                                 Checked="OnSideChanged" VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 안내 / 경고 -->
        <Border DockPanel.Dock="Top" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                BorderBrush="{DynamicResource BorderBrush2}">
            <StackPanel>
                <TextBlock FontSize="12" TextWrapping="Wrap"
                           Text="내 1번째 턴 → 선공 전개 루트 · 내 2번째 턴 → 후공 전개 루트. 내 3번째 턴부터는 기록하지 않습니다. 적용하면 기존 두 루트를 모두 지우고 교체합니다."/>
                <TextBlock x:Name="TxtWarn" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{StaticResource WarnFg}"/>
            </StackPanel>
        </Border>

        <!-- 하단 버튼 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="TxtSummary" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold"/>
            <Button Content="적용" Padding="20,5" IsDefault="True" Click="OnApply"/>
            <Button Content="취소" Padding="20,5" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>

        <DataGrid x:Name="GridActions" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" RowHeight="24" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="턴" Binding="{Binding Turn}" Width="52"/>
                <DataGridTextColumn Header="트랙" Binding="{Binding TrackLabel}" Width="60"/>
                <DataGridTextColumn Header="카드ID" Binding="{Binding Card}" Width="90"/>
                <DataGridTextColumn Header="카드명" Binding="{Binding CardLabel}" Width="*"/>
                <DataGridTextColumn Header="행동" Binding="{Binding ActionLabel}" Width="100"/>
                <DataGridTextColumn Header="메모" Binding="{Binding Note}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
