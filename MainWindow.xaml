                                        <DataGridTemplateColumn Header="카드명 (이름으로 검색)" Width="*" MinWidth="165">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <controls:CardNameBox CardId="{Binding Card, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          AllowEmpty="True" EmptyLabel="(없음)"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="대상(누가)" Width="78">
