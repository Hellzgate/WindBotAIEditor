                                                              SelectedValue="{Binding Side, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="종족" Width="118">
                                            <DataGridTemplateColumn.CellTemplate>
