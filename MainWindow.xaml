<Window x:Class="WindBotAIEditor.MainWindow"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextFg}"
        TextElement.Foreground="{DynamicResource TextFg}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindBotAIEditor"
        xmlns:controls="clr-namespace:WindBotAIEditor.Controls"
        Title="WindBot AI 에디터" Height="1000" Width="1560" MinWidth="1100" MinHeight="700" Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic" FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- ⑤ 전개 루트: 선공 = 파랑 계열 / 후공 = 주황 계열 -->
        <SolidColorBrush x:Key="RouteFirstBrush" Color="#2F6FEB"/>
        <SolidColorBrush x:Key="RouteSecondBrush" Color="#E08B2A"/>

        <!-- ⑤ 트랙 토글 버튼 (B-8): OS 기본 버튼 템플릿의 대비 문제를 피하려고 직접 그린다.
             색은 전부 DynamicResource(테마) — 코드비하인드도 SetResourceReference 로만 지정한다. -->
        <Style x:Key="RouteTrackButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <DockPanel TextElement.Foreground="{DynamicResource TextFg}">
        <!-- ===== 상단 경로 ===== -->
        <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="EDOPro 폴더" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <TextBox Grid.Column="1" x:Name="TxtRoot" VerticalContentAlignment="Center" Padding="4,2" ToolTip="EDOPro.exe 가 있는 폴더"/>
                <Button Grid.Column="2" Content="찾아보기" Margin="8,0,0,0" Click="OnBrowseRoot"/>
                <Button Grid.Column="3" Content="열기" Margin="6,0,0,0" Click="OnOpenRoot"/>
                <Button Grid.Column="4" Content="폴더 선택" Margin="6,0,0,0" Click="OnAutoDetect"/>
                <TextBlock Grid.Column="5" x:Name="TxtCdb" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource AccentFg}" FontSize="11" FontWeight="SemiBold"/>
                <CheckBox Grid.Column="6" x:Name="ChkDarkMode" Content="다크 모드" VerticalAlignment="Center" Margin="12,0,0,0" Checked="OnThemeChanged" Unchecked="OnThemeChanged"/>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="TxtStatus" Text="WindBot 폴더를 선택하세요."/></StatusBarItem>
        </StatusBar>

        <TabControl x:Name="Tabs" Margin="8" SelectionChanged="OnMainTabChanged">

            <!-- ================= 덱 ================= -->
            <TabItem Header="덱">
                <Grid Margin="8">
                    <!-- 덱 목록 | 스플리터 | 덱 편집(남는 폭 전부) — B-7: 엔진/규칙 열은 ⚙ AI 설정 탭으로 분리 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" MinWidth="200"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*" MinWidth="420"/>
                    </Grid.ColumnDefinitions>

                    <!-- 덱 목록 -->
                    <DockPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock DockPanel.Dock="Top" x:Name="LblDeckList" Text="덱 목록" FontWeight="Bold" Margin="0,0,0,6"/>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid Margin="0,0,0,8">
                                <TextBox x:Name="TxtDeckFilter" Padding="6,4" TextChanged="OnDeckFilterChanged"/>
                                <TextBlock x:Name="PhDeckFilter" Text="🔍 덱 이름 검색" Foreground="{DynamicResource HintFg}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <TextBlock Text="새 덱 이름" Foreground="{DynamicResource SubtleFg}" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtNewDeck" Padding="6,4" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="새 덱" Click="OnNewDeck"/>
                                <Button Grid.Column="1" Content="가져오기" Margin="4,0,0,0" Click="OnImportDeck"/>
                                <Button Grid.Column="2" Content="새로고침" Margin="4,0,0,0" Click="OnRefreshDecks"/>
                            </Grid>
                            <Button Content="선택 덱 삭제" Margin="0,4,0,0" Click="OnDeleteDeck"/>
                        </StackPanel>
                        <ListBox x:Name="ListDecks" SelectionChanged="OnDeckSelected" FontSize="13"/>
                    </DockPanel>

                    <!-- 덱 내용 -->
                    <Grid Grid.Column="2" Margin="0,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="110"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="200" MinHeight="90"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" x:Name="TxtDeckInfo" Text="덱을 선택하세요" FontWeight="Bold" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="저장" Click="OnSaveDeck"/>
                            <Button Content="카드 추가" Margin="4,0,0,0" Click="OnAddCardToDeck"/>
                            <Button Content="이름→ID" Margin="4,0,0,0" Click="OnConvertNamesToIds"/>
                        </StackPanel>

                        <TextBox Grid.Row="2" x:Name="TxtDeck" AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Consolas" FontSize="13.5" TextChanged="OnDeckTextChanged"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

                        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="Transparent"
                                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Cursor="SizeNS"/>

                        <Border Grid.Row="4" Padding="6" Background="{DynamicResource SubtleBg}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="3">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="덱 내 카드 검색" FontWeight="Bold" Margin="0,0,0,4"/>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtDeckCardFilter" Padding="3" TextChanged="OnDeckCardFilterChanged"/>
                                    <Button Grid.Column="1" Content="1장 빼기" Margin="6,0,0,0" Click="OnRemoveDeckCard"/>
                                    <TextBlock Grid.Column="2" x:Name="LblDeckCardCount" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource SubtleFg}" FontSize="11"/>
                                </Grid>
                                <ListBox x:Name="ListDeckCards" FontSize="13" MouseDoubleClick="OnDeckCardDoubleClick"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                                  ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE"/>
                </Grid>
            </TabItem>

            <!-- ================= ⚙ AI 설정 (엔진 · 동작 세부 · 규칙 서브탭 · 저장/컴파일/로그) =================
                 B-9: 규칙 ①~⑤ 는 최상위에서 내려와 이 탭의 서브탭(RuleTabs)이 된다.
                 위→아래: 설정 카드(기본 접힘) · 규칙 서브탭(*, MinHeight 340) · 저장/컴파일 + 요약 · 빌드 로그. -->
            <TabItem Header="⚙ AI 설정">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="340"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="100" MinHeight="80"/>
                    </Grid.RowDefinitions>

                    <!-- 설정 카드 (2열) — 창이 좁거나 낮으면 세로 스크롤로 접근 -->
                    <Grid Grid.Row="0" x:Name="PnlSettingsCard" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <Button x:Name="BtnToggleSettings" DockPanel.Dock="Right" Content="설정 펼치기"
                                    Click="OnToggleSettingsPanel" Padding="10,3"
                                    ToolTip="엔진/RPS/선후공/대사 · 체인 중복 기준 · 열 회피 카드를 펼칩니다 (기본은 접힘)"/>
                            <TextBlock Text="엔진 · 동작 세부" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="기본은 접힘 — 엔진/대사/체인 설정을 바꿀 때만 [설정 펼치기]"
                                       Foreground="{DynamicResource HintFg}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" x:Name="PnlSettings" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" MaxHeight="220"
                                      Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="360"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*" MinWidth="360"/>
                                </Grid.ColumnDefinitions>

                                <!-- 왼쪽: 엔진 / 봇 -->
                                <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush2}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="엔진 / 봇" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" MinWidth="110"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" MinWidth="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="엔진" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                                            <TextBox Grid.Column="1" x:Name="TxtEngineName" Text="MyDeck" TextChanged="OnEngineNameChanged"/>
                                            <TextBlock Grid.Column="2" Text="설명" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                            <TextBox Grid.Column="3" x:Name="TxtEngineDesc" Text="커스텀 덱 AI"/>
                                        </Grid>
                                        <WrapPanel Margin="0,8,0,0">
                                            <CheckBox x:Name="ChkFreePlay" Content="자유 플레이" IsChecked="True" VerticalAlignment="Center"
                                                      ToolTip="규칙을 지정하지 않은 행동 유형은 기본 AI 동작을 자동 추가합니다"/>
                                            <CheckBox x:Name="ChkDebugEffect" Content="효과번호 기록" Margin="14,0,0,0" VerticalAlignment="Center"
                                                      ToolTip="발동 시 카드ID/효과번호(desc)를 WindBot 콘솔에 기록합니다"/>
                                        </WrapPanel>

                                        <!-- B-15: 자유 플레이에 마법/함정 세트(SpellSet) 추가 — 기본 OFF -->
                                        <CheckBox x:Name="ChkFreePlaySetSpell" Margin="0,8,0,0" VerticalAlignment="Center"
                                                  Checked="OnFreePlaySetSpellChanged" Unchecked="OnFreePlaySetSpellChanged"
                                                  ToolTip="자유 플레이에 ExecutorType.SpellSet 을 추가합니다 — 함정·속공은 패에서 발동할 수 없어 세트만 가능하므로, 이 옵션이 없으면 패에서 썩습니다">
                                            <TextBlock Text="자유 플레이 시 마법/함정도 세트" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <Grid x:Name="PnlFreePlaySetSpell" Margin="20,6,0,0" Visibility="Collapsed">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="종류" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ComboBox Grid.Column="1" x:Name="CmbFreePlaySetKind" Style="{DynamicResource ThemedComboBox}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Id"
                                                          ToolTip="세트할 카드 종류 — 전체(마법+함정) / 함정만 / 속공 마법만"/>
                                                <TextBlock Grid.Column="2" Text="제외 카드" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                                <controls:CardNameBox Grid.Column="3" x:Name="CardFreePlaySetExclude"
                                                                      AllowEmpty="True" EmptyLabel="(카드 검색)"
                                                                      ToolTip="패트랩처럼 세트하면 안 되는 카드 — 고르고 [추가]"/>
                                                <Button Grid.Column="4" Content="추가" Margin="6,0,0,0" Click="OnAddFreePlaySetExclude"
                                                        ToolTip="선택한 카드를 세트 제외 목록에 추가"/>
                                                <Button Grid.Column="5" Content="비우기" Margin="6,0,0,0" Click="OnClearFreePlaySetExclude"
                                                        ToolTip="세트 제외 목록을 비웁니다"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1" x:Name="TxtFreePlaySetExclude" Text="(없음)" FontSize="11" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource HintFg}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="세트하지 않을 카드 목록"/>
                                        </Grid>
                                        <!-- B-16: 자유 플레이에서 엑스트라 덱 몬스터를 릴리스/제물로 쓰지 않음 — 기본 ON -->
                                        <CheckBox x:Name="ChkFreePlayProtectExtra" IsChecked="True" Margin="0,8,0,0" VerticalAlignment="Center"
                                                  ToolTip="릴리스/제물 후보에서 융합·싱크로·엑시즈·링크 몬스터를 뺍니다 (소재 사용은 그대로 허용). 남은 후보가 min 미만이면 원래 목록을 씁니다 — 엔진 오류 방지">
                                            <TextBlock Text="자유 플레이 시 엑스트라 덱 몬스터를 릴리스/제물로 쓰지 않음" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="가위바위보" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox Grid.Column="1" x:Name="CmbRps" Style="{DynamicResource ThemedComboBox}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Id"/>
                                            <TextBlock Grid.Column="2" Text="이겼을 때" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                            <ComboBox Grid.Column="3" x:Name="CmbTurnChoice" Style="{DynamicResource ThemedComboBox}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Id"/>
                                            <TextBlock Grid.Column="4" Text="선공/후공은 [생성 + 컴파일] 후 적용"
                                                       Foreground="{DynamicResource HintFg}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="대사" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox Grid.Column="1" x:Name="CmbDialog" Style="{DynamicResource ThemedComboBox}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Id"/>
                                            <Button Grid.Column="2" Content="대사 편집" Margin="8,0,0,0" Click="OnEditEngineDialog"/>
                                        </Grid>
                                        <TextBlock Text="대사는 이 엔진 전용입니다 (EDOPro 가 실행하는 봇에도 적용 · 재컴파일 필요)"
                                                   Foreground="{DynamicResource HintFg}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- 오른쪽: 동작 세부 -->
                                <Border Grid.Column="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush2}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="동작 세부" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="체인 중복 기준" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox Grid.Column="1" x:Name="CmbChainBasis" Style="{DynamicResource ThemedComboBox}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Id"
                                                      ToolTip="'체인당 N회 제한' 이 같은 카드/이름/테마를 몇 번까지 허용할지 판정하는 기준"/>
                                            <TextBlock Grid.Column="2" Text="'체인당 N회 제한' 판정 기준"
                                                       Foreground="{DynamicResource HintFg}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="열 회피 카드" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <controls:CardNameBox Grid.Column="1" x:Name="CardAvoidColumn"
                                                                  AllowEmpty="True" EmptyLabel="(없음)"/>
                                            <TextBlock Grid.Column="2" Text="그 카드가 놓인 세로열에 마법/함정을 두지 않음"
                                                       Foreground="{DynamicResource HintFg}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                                        </Grid>
                                        <CheckBox x:Name="ChkSameNameAliases" IsChecked="True" Margin="0,8,0,0" VerticalAlignment="Center"
                                                  ToolTip="cdb 의 카드 이름이 같으면 같은 카드로 취급합니다. 예) 59438930 ↔ 59438931 (유령토끼 · 다른 일러) — 금지/행동/선택/조건/열 회피 규칙이 그룹 전체에 적용됩니다">
                                            <TextBlock Text="같은 이름 카드(대체 일러·재록)도 같은 카드로 취급" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <TextBlock Text="소환 존 · 표시 형식 · 금지 세부는 ①③ 탭의 각 규칙 행에서 지정합니다 (전역 설정 없음)"
                                                   Foreground="{DynamicResource HintFg}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="현재 규칙 요약은 아래 [규칙 저장] 줄에 표시됩니다"
                                                   Foreground="{DynamicResource HintFg}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- ================= 규칙 서브탭 (B-9: ①~⑤ 는 ⚙ AI 설정 하위) ================= -->
                    <TabControl x:Name="RuleTabs" Grid.Row="1" Margin="0,0,0,6">
                        <TabControl.Resources>
                            <!-- 서브탭은 최상위 탭보다 조금 크게 + 선택 시 강조색 밑줄 (테마 브러시만 사용) -->
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="{DynamicResource CardBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                                <Setter Property="Padding" Value="14,6"/>
                                <Setter Property="FontSize" Value="13.5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,3"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter ContentSource="Header"
                                                                  TextElement.Foreground="{DynamicResource TextFg}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
