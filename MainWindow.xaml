                                                    <CheckBox IsChecked="{Binding Not, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              ToolTip="조건을 부정합니다 → !(조건) · 패에 테마 몬스터가 &quot;없다&quot; 같은 조건에 사용"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- 금지 규칙 -->
                        <TabItem Header="③ 금지 규칙">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="165"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="금지 규칙 — 특정 카드의 특정 행동 차단" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="추가" Margin="8,0,0,0" Click="OnAddForbid"/>
                                    <Button Content="삭제" Margin="4,0,0,0" Click="OnRemoveForbid"/>
                                    <TextBlock Text="&quot;내 카드&quot;는 AI 자신의 카드 기준 · 카드ID 0 = 전체 · 체인 중복 기준은 ⚙ AI 설정 탭"
                                               Foreground="{DynamicResource HintFg}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </DockPanel>
                                <DataGrid Grid.Row="1" x:Name="GridForbids" SelectionChanged="OnForbidSelected">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="우선" Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="42"/>
                                        <DataGridTextColumn Header="카드ID" Binding="{Binding Card, UpdateSourceTrigger=PropertyChanged}" Width="74"/>
                                        <DataGridTemplateColumn Header="카드명 (이름으로 검색)" Width="*" MinWidth="165">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <controls:CardNameBox CardId="{Binding Card, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          AllowEmpty="True" EmptyLabel="(전체)"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="금지 행동" Width="186">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{DynamicResource ThemedComboBox}" ItemsSource="{Binding Source={x:Static local:MainWindow.ForbidActions}}"
                                                              SelectedItem="{Binding ActionName, UpdateSourceTrigger=PropertyChanged}"
                                                              ToolTip="{Binding ActionName.Hint}"
                                                              DisplayMemberPath="Label"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="효과" Binding="{Binding EffectDesc, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                                        <DataGridTextColumn Header="횟수" Binding="{Binding ChainLimit, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                                        <DataGridTemplateColumn Header="턴" Width="84">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{DynamicResource ThemedComboBox}" ItemsSource="{Binding Source={x:Static local:MainWindow.TurnScopes}}"
                                                              SelectedItem="{Binding TurnScopeName, UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayMemberPath="Label"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="조건 해석" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{DynamicResource ThemedComboBox}" ItemsSource="{Binding Source={x:Static local:MainWindow.ConditionModes}}"
                                                              SelectedItem="{Binding ConditionModeName, UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayMemberPath="Label"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="메모" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DockPanel Grid.Row="2" Margin="0,8,0,4">
                                    <TextBlock Text="조건 — [조건 해석]으로 예외/조건부 금지 · 값 0 = 전체 · 이벤트 조건은 [대상(누가)] 열" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="조건 추가" Margin="8,0,0,0" Click="OnAddForbidCond"/>
                                    <Button Content="삭제" Margin="4,0,0,0" Click="OnRemoveForbidCond"/>
                                    <Button Content="행동 조건 복사" Margin="8,0,0,0" Click="OnCopyForbidCondFromAction"
                                            ToolTip="같은 카드의 행동 규칙에 설정된 조건을 예외 조건으로 그대로 복사합니다"/>
                                    <TextBlock x:Name="ForbidCondTitle" Text="" Foreground="{DynamicResource HintFg}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </DockPanel>

                                <DataGrid Grid.Row="3" x:Name="GridForbidConds">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="연결" Width="54">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{DynamicResource ThemedComboBox}" ItemsSource="{Binding Source={x:Static local:MainWindow.Joins}}"
                                                              SelectedItem="{Binding Join, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="조건" Width="176">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{DynamicResource ThemedComboBox}" ItemsSource="{Binding Source={x:Static local:MainWindow.ConditionKinds}}"
                                                              SelectedItem="{Binding KindName, UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayMemberPath="Label"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="비교" Width="54">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{DynamicResource ThemedComboBox}" ItemsSource="{Binding Source={x:Static local:MainWindow.Ops}}"
                                                              SelectedItem="{Binding Op, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="값" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                                        <DataGridTextColumn Header="카드ID" Binding="{Binding Card, UpdateSourceTrigger=PropertyChanged}" Width="74"/>
                                        <DataGridTemplateColumn Header="카드명 (이름으로 검색)" Width="*" MinWidth="165">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <controls:CardNameBox CardId="{Binding Card, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          AllowEmpty="True" EmptyLabel="(없음)"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="대상(누가)" Width="78">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{DynamicResource ThemedComboBox}" ItemsSource="{Binding Source={x:Static local:MainWindow.Sides}}"
                                                              SelectedValuePath="Id" DisplayMemberPath="Label"
                                                              IsEnabled="{Binding SideEditable}"
                                                              ToolTip="이벤트 조건은 조건 이름에 나/상대가 포함되어 있어 이 칸은 잠깁니다"
                                                              SelectedValue="{Binding Side, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="종족" Width="118">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <controls:OptionSearchBox Options="{Binding Source={x:Static local:MainWindow.Races}}"
                                                                              SelectedCode="{Binding RaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              AllowZero="True" ZeroLabel="전체 (종족 무관)"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="테마" Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <controls:OptionSearchBox Options="{Binding Source={x:Static local:MainWindow.Themes}}"
                                                                              SelectedCode="{Binding ThemeCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              IsEnabled="{Binding ThemeEditable}"
                                                                              AllowZero="True" ZeroLabel="전체 (테마 무관)"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="몬스터만" Width="68">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding MonsterOnly, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsEnabled="{Binding ThemeEditable}"
                                                              ToolTip="테마 조건에서 몬스터만 (Data.Type &amp; 0x1) — 테마 조건에서만 의미가 있습니다"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="부정(!)" Width="62">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Not, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              ToolTip="조건을 부정합니다 → !(조건) · 패에 테마 몬스터가 &quot;없다&quot; 같은 조건에 사용"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- 트리거 -->
                        <TabItem Header="④ 트리거">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="완성 트리거 — 특정 카드가 있으면 빌드 완료" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="추가" Margin="8,0,0,0" Click="OnAddTrigger"/>
                                    <Button Content="삭제" Margin="4,0,0,0" Click="OnRemoveTrigger"/>
                                    <TextBlock Text="같은 그룹은 AND/OR, 그룹끼리는 OR" Foreground="{DynamicResource HintFg}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </DockPanel>
                                <DataGrid Grid.Row="1" x:Name="GridTriggers">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="우선" Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="42"/>
                                        <DataGridTextColumn Header="카드ID" Binding="{Binding Card, UpdateSourceTrigger=PropertyChanged}" Width="74"/>
                                        <DataGridTemplateColumn Header="카드명 (이름으로 검색)" Width="*" MinWidth="165">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <controls:CardNameBox CardId="{Binding Card, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          AllowEmpty="False" EmptyLabel="(선택)"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="그룹" Binding="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Width="46"/>
                                        <DataGridTemplateColumn Header="연결" Width="54">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{DynamicResource ThemedComboBox}" ItemsSource="{Binding Source={x:Static local:MainWindow.Joins}}"
                                                              SelectedItem="{Binding Join, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="위치" Width="92">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{DynamicResource ThemedComboBox}" ItemsSource="{Binding Source={x:Static local:MainWindow.FinishZones}}"
                                                              SelectedItem="{Binding ZoneName, UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayMemberPath="Label"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="완료 시" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{DynamicResource ThemedComboBox}" ItemsSource="{Binding Source={x:Static local:MainWindow.FinishActions}}"
                                                              SelectedItem="{Binding DoneName, UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayMemberPath="Label"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridCheckBoxColumn Header="규칙 중단" Binding="{Binding StopOthers, UpdateSourceTrigger=PropertyChanged}" Width="68"/>
                                        <DataGridTextColumn Header="메모" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DockPanel Grid.Row="2" Margin="0,8,0,4">
                                    <TextBlock Text="상대 발동 트리거 — 상대가 A를 쓰면 내 B로 대응" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="추가" Margin="8,0,0,0" Click="OnAddOpp"/>
                                    <Button Content="삭제" Margin="4,0,0,0" Click="OnRemoveOpp"/>
                                </DockPanel>
                                <DataGrid Grid.Row="3" x:Name="GridOpps">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="우선" Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="42"/>
                                        <DataGridTextColumn Header="상대 카드ID" Binding="{Binding Card, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
                                        <DataGridTemplateColumn Header="상대 카드명 (이름으로 검색)" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <controls:CardNameBox CardId="{Binding Card, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          AllowEmpty="False" EmptyLabel="(선택)"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="내 대응 ID" Binding="{Binding ResponseCard, UpdateSourceTrigger=PropertyChanged}" Width="92"/>
                                        <DataGridTemplateColumn Header="내 대응 카드명 (이름으로 검색)" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <controls:CardNameBox CardId="{Binding ResponseCard, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          AllowEmpty="True" EmptyLabel="(플래그만)"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="메모" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <!-- 전개 루트 -->
                        <TabItem Header="⑤ 전개 루트">
                            <ScrollViewer x:Name="ScrollRouteTab" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="6" MinHeight="{Binding ViewportHeight, ElementName=ScrollRouteTab}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*" MinHeight="200"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="160"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                        <Button Content="+ 루트" Click="OnAddRouteSet" FontWeight="SemiBold"
                                                ToolTip="이 트랙(선공/후공)에 루트를 한 벌 더 추가합니다"/>
                                        <Button Content="+ 단계 추가" Click="OnAddRoute" Margin="8,0,0,0" FontWeight="SemiBold"
                                                ToolTip="선택한 루트의 끝에 단계를 추가합니다"/>
                                        <Button Content="리플레이 가져오기" Click="OnImportReplay" Margin="8,0,0,0" FontWeight="SemiBold"
                                                ToolTip="패 테스트 등에서 전개 루트만 기록한 리플레이를 요구합니다. 선택된 트랙의 루트를 모두 지우고 '리플레이' 1벌로 교체합니다."/>
                                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                                                   Foreground="{DynamicResource HintFg}" TextWrapping="Wrap"
                                                   Text="트랙마다 루트 N벌 · 기본이 아닌 루트를 위에서부터 조건 검사 → 처음 만족한 1벌만 실행 · 없으면 기본 루트 · 기본도 없으면 전개 안 함"/>
                                    </DockPanel>

                                    <!-- 선공 / 후공 세그먼트 토글 (B-8: 선택/비선택 모두 읽히도록 테마 브러시 사용) -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button x:Name="BtnRouteFirst" Content="■ 선공 전개" Click="OnRouteTrackFirst"
                                                Style="{DynamicResource RouteTrackButton}"
                                                FontSize="14" Padding="16,6" MinWidth="140"/>
                                        <Button x:Name="BtnRouteSecond" Content="후공 전개" Click="OnRouteTrackSecond"
                                                Style="{DynamicResource RouteTrackButton}"
                                                FontSize="14" Padding="16,6" MinWidth="140" Margin="8,0,0,0"/>
                                        <TextBlock x:Name="TxtRouteStatus" Margin="14,0,0,0" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                    </StackPanel>

                                    <!-- 후공 배지 / 빈 루트 경고 / 선택 규칙 안내 -->
                                    <Border Grid.Row="2" x:Name="PnlRouteNotice" BorderThickness="1" CornerRadius="4"
                                            Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtRouteNotice" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- 좌: 루트 목록 / 우: 선택한 루트의 단계 카드 -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="250" MinWidth="170"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*" MinWidth="360"/>
                                        </Grid.ColumnDefinitions>

                                        <DockPanel Grid.Column="0">
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                                <Button DockPanel.Dock="Right" Content="이름 변경" Click="OnRenameRouteSet" Padding="8,2"/>
                                                <TextBlock Text="루트 목록" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                                <Button Content="삭제" Click="OnRemoveRouteSet" Padding="8,2"/>
                                                <Button Content="▲" Click="OnMoveRouteSetUp" Width="28" Margin="4,0,0,0" Padding="0"/>
                                                <Button Content="▼" Click="OnMoveRouteSetDown" Width="28" Margin="4,0,0,0" Padding="0"/>
                                                <Button Content="★ 기본으로" Click="OnSetDefaultRouteSet" Margin="4,0,0,0" Padding="8,2"/>
                                            </DockPanel>
                                            <Grid MinHeight="140">
                                                <ListBox x:Name="ListRouteSets" SelectionChanged="OnRouteSetSelected"
                                                         MinHeight="140"
                                                         Background="{DynamicResource SubtleBg}"
                                                         BorderBrush="{DynamicResource BorderBrush2}"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,2">
                                                                <DockPanel>
                                                                    <Border DockPanel.Dock="Right" CornerRadius="3" Padding="4,0"
                                                                            Background="{DynamicResource CardBg}"
                                                                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                                                                        <TextBlock Text="{Binding ConditionBadge}" FontSize="10"
                                                                                   Foreground="{DynamicResource SubtleFg}"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding DefaultBadge}" FontSize="10" FontWeight="Bold"
                                                                               Margin="0,0,4,0" VerticalAlignment="Center"
                                                                               Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"/>
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding StepBadge}" FontSize="10" Margin="0,1,0,0"
                                                                           Foreground="{DynamicResource SubtleFg}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <!-- 빈 상태 문구는 목록 영역 안에 겹쳐서 표시한다 (B-8) -->
                                                <TextBlock x:Name="TxtRouteSetsEmpty"
                                                           Text="루트가 없습니다 — 위의 [+ 루트] 로 추가하세요"
                                                           Foreground="{DynamicResource HintFg}" TextWrapping="Wrap"
                                                           Margin="10,8,10,0" VerticalAlignment="Top" IsHitTestVisible="False"/>
                                            </Grid>
                                        </DockPanel>

                                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch" Background="Transparent"/>

                                        <Grid Grid.Column="2">
                                            <ScrollViewer x:Name="ScrollRouteSteps" MinHeight="140"
                                                          VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                                <ItemsControl x:Name="ItemsRoute">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,8" CornerRadius="6" BorderThickness="1"
                                                                    BorderBrush="{DynamicResource BorderBrush2}"
                                                                    Background="{DynamicResource CardBg}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" CornerRadius="6,0,0,6"
                                                                            Background="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                                                                    <StackPanel Grid.Column="1" Margin="10,8,10,10">
                                                                        <DockPanel Margin="0,0,0,4">
                                                                            <Button DockPanel.Dock="Right" Content="삭제" Margin="6,0,0,0" Click="OnRemoveRouteStep"/>
                                                                            <Button DockPanel.Dock="Right" Content="▼" Width="30" Margin="4,0,0,0" Click="OnMoveRouteStepDown"/>
                                                                            <Button DockPanel.Dock="Right" Content="▲" Width="30" Margin="4,0,0,0" Click="OnMoveRouteStepUp"/>
                                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" MinWidth="56"
                                                                                       VerticalAlignment="Center"
                                                                                       Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                                                                            <TextBlock Text="메모" Margin="8,0,4,0" VerticalAlignment="Center"
                                                                                       Foreground="{DynamicResource SubtleFg}" FontSize="11"/>
                                                                            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                                                     VerticalContentAlignment="Center" Padding="4,2" MinWidth="180"/>
                                                                        </DockPanel>
                                                                        <ItemsControl ItemsSource="{Binding Options}"
                                                                                      Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <DockPanel Margin="0,3,0,0">
                                                                                        <TextBlock Text="{Binding RankLabel}" Width="26" FontWeight="SemiBold"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                                                                                        <Button DockPanel.Dock="Right" Content="✕" Width="30" Margin="4,0,0,0"
                                                                                                Click="OnRemoveRouteOption" ToolTip="이 순위 삭제"/>
                                                                                        <ComboBox DockPanel.Dock="Right" Width="130" Margin="6,0,0,0"
                                                                                                  Style="{DynamicResource ThemedComboBox}"
                                                                                                  ItemsSource="{Binding Source={x:Static local:MainWindow.ExecutorTypes}}"
                                                                                                  SelectedItem="{Binding Action, UpdateSourceTrigger=PropertyChanged}"/>
                                                                                        <TextBlock DockPanel.Dock="Right" Text="→" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                                   Foreground="{DynamicResource SubtleFg}"/>
                                                                                        <Button DockPanel.Dock="Right" Content="{Binding ConditionBadge}" MinWidth="88" Margin="6,0,0,0"
                                                                                                Click="OnEditRouteOptionConditions" ToolTip="이 순위의 조건을 아래에서 편집"/>
                                                                                        <controls:CardNameBox CardId="{Binding Card, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                              AllowEmpty="True" EmptyLabel="(카드 검색)"/>
                                                                                    </DockPanel>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <Button Content="+ 순위 추가" Margin="0,6,0,0" HorizontalAlignment="Left" Click="OnAddRouteOption"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <TextBlock x:Name="TxtRouteEmpty" Text="루트를 선택하면 단계가 표시됩니다"
                                                       Foreground="{DynamicResource HintFg}" Margin="12,10,0,0"
                                                       VerticalAlignment="Top" IsHitTestVisible="False" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Grid>

                                    <DockPanel Grid.Row="4" Margin="0,8,0,4">
                                        <TextBlock x:Name="TxtRouteCondHeader" Text="루트를 선택하면 진입 조건을, 순위 [조건]을 누르면 그 순위 조건을 편집합니다"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Content="조건 추가" Margin="8,0,0,0" Click="OnAddRouteCond"/>
                                        <Button Content="삭제" Margin="4,0,0,0" Click="OnRemoveRouteCond"/>
                                        <Button Content="카드 선택" Margin="8,0,0,0" Click="OnPickRouteCondCard"/>
                                        <TextBlock Text="연결(and/or)로 AND·OR 혼합 · 루트 진입 조건이 비어 있으면 항상 그 루트를 선택"
                                                   Foreground="{DynamicResource HintFg}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </DockPanel>

                                    <DataGrid Grid.Row="5" x:Name="GridRouteConds">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="연결" Width="54">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox Style="{DynamicResource ThemedComboBox}" ItemsSource="{Binding Source={x:Static local:MainWindow.Joins}}"
                                                                  SelectedItem="{Binding Join, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="조건" Width="176">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox Style="{DynamicResource ThemedComboBox}" ItemsSource="{Binding Source={x:Static local:MainWindow.ConditionKinds}}"
                                                                  SelectedItem="{Binding KindName, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayMemberPath="Label"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="비교" Width="54">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox Style="{DynamicResource ThemedComboBox}" ItemsSource="{Binding Source={x:Static local:MainWindow.Ops}}"
                                                                  SelectedItem="{Binding Op, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="값" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                                            <DataGridTextColumn Header="카드ID" Binding="{Binding Card, UpdateSourceTrigger=PropertyChanged}" Width="74"/>
                                            <DataGridTemplateColumn Header="카드명 (이름으로 검색)" Width="*" MinWidth="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <controls:CardNameBox CardId="{Binding Card, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              AllowEmpty="True" EmptyLabel="(없음)"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="대상(누가)" Width="78">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox Style="{DynamicResource ThemedComboBox}" ItemsSource="{Binding Source={x:Static local:MainWindow.Sides}}"
                                                                  SelectedValuePath="Id" DisplayMemberPath="Label"
                                                                  IsEnabled="{Binding SideEditable}"
                                                                  SelectedValue="{Binding Side, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="종족" Width="118">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <controls:OptionSearchBox Options="{Binding Source={x:Static local:MainWindow.Races}}"
                                                                                  SelectedCode="{Binding RaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                  AllowZero="True" ZeroLabel="전체 (종족 무관)"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="테마" Width="160">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <controls:OptionSearchBox Options="{Binding Source={x:Static local:MainWindow.Themes}}"
                                                                                  SelectedCode="{Binding ThemeCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                  IsEnabled="{Binding ThemeEditable}"
                                                                                  AllowZero="True" ZeroLabel="전체 (테마 무관)"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="몬스터만" Width="68">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding MonsterOnly, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  IsEnabled="{Binding ThemeEditable}"
                                                                  ToolTip="테마 조건에서 몬스터만 (Data.Type &amp; 0x1)"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="부정(!)" Width="62">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Not, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  ToolTip="조건을 부정합니다 → !(조건)"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>

                    <!-- 실행 버튼 + 현재 규칙 요약 -->
                    <StackPanel Grid.Row="2" Margin="0,4,0,6">
                        <WrapPanel>
                            <Button Content="규칙 저장 (JSON)" Click="OnSaveProfile" FontWeight="SemiBold"/>
                            <Button Content="규칙 불러오기" Margin="6,0,0,0" Click="OnLoadProfile"/>
                            <Button Content="소스 미리보기" Margin="10,0,0,0" Click="OnPreviewSource"/>
                            <Button Content="생성 + 컴파일" Margin="6,0,0,0" Click="OnBuildEngine" FontWeight="Bold" Background="{DynamicResource AccentBg}" Foreground="{DynamicResource AccentFg}"/>
                        </WrapPanel>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="TxtRuleSummary" FontWeight="SemiBold"
                                       Text="행동 0 · 선택 0 · 금지 0 · 트리거 0 · 선공 루트 0벌 / 후공 0벌"/>
                            <TextBlock Grid.Column="1" x:Name="TxtProfilePath" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubtleFg}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>

                    <TextBox Grid.Row="3" x:Name="TxtBuildLog" IsReadOnly="True" FontFamily="Consolas"
                             MinHeight="80"
                             FontSize="11.5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" Background="{DynamicResource SubtleBg}"/>
                </Grid>
            </TabItem>

            <!-- ================= 봇 목록 ================= -->
            <TabItem Header="봇 목록 (로비 AI)">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Foreground="{DynamicResource SubtleFg}"
                                   Text="bots.json — EDOPro 로비의 'AI 리스트'에 표시되는 항목입니다."/>
                        <DataGrid x:Name="GridBots" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="이름 (로비 표시)" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="덱" Binding="{Binding Deck}" Width="2*"/>
                                <DataGridTextColumn Header="AI 레벨 (0~3)" Binding="{Binding Difficulty}" Width="110"/>
                                <DataGridTextColumn Header="마스터 룰 (예: 4, 5)" Binding="{Binding MasterRulesText}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <StackPanel Grid.Column="1" Margin="10,24,0,0">
                        <Button Content="항목 추가" Margin="0,0,0,6" Click="OnAddBot"/>
                        <Button Content="선택 삭제" Margin="0,0,0,6" Click="OnRemoveBot"/>
                        <Button Content="선택 복제" Margin="0,0,0,6" Click="OnDuplicateBot"/>
                        <Button Content="선택 덱으로 자동 추가" Margin="0,0,0,8" Click="OnAddBotFromDeck"/>
                        <Button Content="배포용 ZIP 내보내기" Margin="0,0,0,16" Click="OnExportBot"
                                ToolTip="선택한 봇(실행기 DLL + 덱 + 대사 + bots.json 항목 + 설치 스크립트)을 ZIP 하나로 묶습니다"/>
                        <Button Content="저장" Click="OnSaveBots" FontWeight="Bold" Background="{DynamicResource AccentBg}" Foreground="{DynamicResource AccentFg}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ================= 봇 대사 ================= -->
            <TabItem Header="봇 대사">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="대사 파일" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbDialogFile" Width="200" Margin="6,0,0,0" Style="{DynamicResource ThemedComboBox}"
                                  SelectionChanged="OnDialogFileChanged"/>
                        <Button Content="새 파일" Margin="8,0,0,0" Click="OnNewDialogFile"/>
                        <Button Content="새로고침" Margin="4,0,0,0" Click="OnRefreshDialogFiles"
                                ToolTip="Dialogs 폴더를 다시 읽습니다 (외부에서 파일을 추가/수정한 경우)"/>
                        <Button Content="저장" Margin="4,0,0,0" Click="OnSaveDialog" FontWeight="Bold"/>
                        <Button Content="default.json 에 적용" Margin="12,0,0,0" Click="OnApplyDialogAsDefault"
                                ToolTip="모든 봇이 기본으로 사용하는 대사로 덮어씁니다 (원본은 .bak 으로 백업)"/>
                        <TextBlock x:Name="TxtDialogPath" Foreground="{DynamicResource HintFg}" FontSize="11"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0" x:Name="ListDialogKeys" SelectionChanged="OnDialogKeyChanged"/>
                        <DockPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock DockPanel.Dock="Top" x:Name="TxtDialogHelp" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SubtleFg}" Margin="0,0,0,4"
                                       Text="한 줄에 하나씩 = 대사 후보 (그중 하나가 랜덤으로 출력됩니다). {0} {1} 은 카드 이름으로 바뀝니다."/>
                            <TextBox x:Name="TxtDialogLines" AcceptsReturn="True" AcceptsTab="True" FontSize="13"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= 카드 DB / Lua ================= -->
            <TabItem Header="카드 DB / Lua">
                <local:CardDbPanel x:Name="CardPanel"/>
            </TabItem>

            <!-- ================= 검증/실행 ================= -->
            <TabItem Header="검증 / 실행">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="검증 실행" Click="OnValidate" FontWeight="Bold"/>
                        <Button Content="bots.json 백업" Margin="8,0,0,0" Click="OnBackupBots"/>
                        <Button Content="CDB 다시 열기" Margin="8,0,0,0" Click="OnReloadCdb"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="ListIssues" FontFamily="Consolas" FontSize="12"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="WindBot 실행" Click="OnRunWindBot"/>
                        <Button Content="EDOPro 실행" Margin="8,0,0,0" Click="OnRunEDOPro"/>
                        <TextBlock x:Name="TxtRunHint" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleFg}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>





















