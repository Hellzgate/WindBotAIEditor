<Window x:Class="WindBotAIEditor.GeneratedCodeWindow"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextFg}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="생성 코드 (읽기 전용)" Height="760" Width="1120"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Malgun Gothic" FontSize="13">
    <DockPanel Margin="10">

        <!-- 안내 + 검색/빠른 이동 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock x:Name="TxtInfo" Foreground="{DynamicResource SubtleFg}" FontSize="12" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBox x:Name="TxtFind" Width="220" MinHeight="28" VerticalContentAlignment="Center"
                         Style="{StaticResource ThemedTextBox}" ToolTip="찾을 문자열"/>
                <Button Content="찾기" MinHeight="28" MinWidth="56" Margin="6,0,0,0" Click="OnFind"/>
                <Button Content="다음" MinHeight="28" MinWidth="56" Margin="4,0,0,0" Click="OnFindNext"/>
                <TextBlock Text="빠른 이동:" VerticalAlignment="Center" Margin="16,0,6,0" FontSize="12"/>
                <Button Content="⑤ 루트 선택" MinHeight="28" Margin="0,0,0,0" Click="OnJumpRoutes"
                        ToolTip="SelectRouteFirst / SelectRouteSecond — 어떤 손패에서 어떤 루트가 선택되는지"/>
                <Button Content="② 카드 선택" MinHeight="28" Margin="4,0,0,0" Click="OnJumpPick"
                        ToolTip="OnSelectCard — ② 선택 규칙"/>
                <Button Content="CountCard" MinHeight="28" Margin="4,0,0,0" Click="OnJumpCount"
                        ToolTip="cardCount 조건 헬퍼"/>
                <Button Content="① AddExecutor" MinHeight="28" Margin="4,0,0,0" Click="OnJumpExec"
                        ToolTip="실행기 등록부(생성자)"/>
            </StackPanel>
        </StackPanel>

        <!-- 하단 버튼 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="전체 복사" MinHeight="28" MinWidth="80" Click="OnCopy"/>
            <Button Content="닫기" MinHeight="28" MinWidth="80" Margin="6,0,0,0" Click="OnClose"/>
        </StackPanel>

        <!-- 본문 -->
        <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush2}">
            <TextBox x:Name="TxtCode" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextFg}"
                     BorderThickness="0" Padding="6"/>
        </Border>
    </DockPanel>
</Window>
