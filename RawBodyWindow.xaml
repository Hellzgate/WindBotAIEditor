<Window x:Class="WindBotAIEditor.RawBodyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="원본 코드 (rawBody)" Height="560" Width="820"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#2B2D30" Foreground="#EAEAEA" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle" Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="원본 핸들러 본문 — 조건은 ① 그리드에서 편집하고, 여기서는 **동작(본문)** 만 고칩니다"/>

        <TextBox x:Name="TxtBody" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="#1E1F22" Foreground="#EAEAEA" BorderBrush="#3C3F44"
                 SpellCheck.IsEnabled="False"/>

        <TextBlock Grid.Row="2" Text="진단 (C#5 · csc v4.0)" Margin="0,8,0,4" FontSize="11" Foreground="#A0A4AA"/>
        <TextBox x:Name="TxtDiag" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="#1E1F22" Foreground="#C8C8C8" BorderBrush="#3C3F44"/>

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <Button x:Name="BtnVerify" DockPanel.Dock="Left" Content="검증 (C#5)" Width="110" Height="30" Click="OnVerify"
                    ToolTip="지금 본문으로 생성 코드를 만들어 실제 csc v4.0 으로 컴파일합니다"/>
            <Button x:Name="BtnSave" DockPanel.Dock="Left" Content="저장" Width="90" Height="30" Margin="8,0,0,0" Click="OnSave"
                    IsEnabled="False" ToolTip="검증을 통과해야 저장됩니다"/>
            <Button x:Name="BtnRevert" DockPanel.Dock="Left" Content="되돌리기" Width="96" Height="30" Margin="8,0,0,0" Click="OnRevert"/>
            <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="닫기" Width="80" Height="30" IsCancel="True" Click="OnClose"/>
            <TextBlock x:Name="TxtState" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0"
                       FontSize="11" Foreground="#A0A4AA"/>
        </DockPanel>
    </Grid>
</Window>
